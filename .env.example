# Autotask API credentials for stdio and for HTTP when AUTH_MODE=env.
# The gateway Compose service does not load these. Do not add them to that
# service's environment or via env_file.
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
AUTOTASK_INTEGRATION_CODE=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, placeholder,
# your-s2s-secret, secret, password, test, an unresolved ${...} template, and
# similar stand-ins). Value is the gateway-provisioned service-to-service
# secret. Never commit a real secret.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without a usable
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and listens on 127.0.0.1 only (a wider MCP_HTTP_HOST is ignored).
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when CONDUIT_S2S_SECRET is set. Without a usable secret the
# server binds 127.0.0.1. The container image sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Credential source for HTTP: env (AUTOTASK_* after X-Gateway-S2S verifies)
# or gateway (required X-API-Key, X-API-Secret, and X-Integration-Code
# headers; no env fallback). Compose sets gateway. Stdio ignores this.
# AUTH_MODE=env
